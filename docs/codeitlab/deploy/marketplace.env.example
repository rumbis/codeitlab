# CodeitLab marketplace — production environment.
# Copy to /etc/codeitlab/marketplace.env, chmod 600, fill the two secrets.
# Every line here is read by apps/marketplace/src/server/main.ts (PORT, HOST) or
# by the marketplace's own MARKETPLACE_* lookups.

# --- where it listens -------------------------------------------------------
PORT=4174
HOST=127.0.0.1
# Absolute path on a persistent disk. The directory must be writable by the
# service user; backups go to <db dir>/backups unless MARKETPLACE_BACKUP_DIR set.
MARKETPLACE_DB=/var/lib/codeitlab/marketplace.sqlite
MARKETPLACE_BACKUP_DIR=/var/backups/codeitlab

# --- public address ---------------------------------------------------------
# The URL a visitor types, including the mount path.
MARKETPLACE_BASE_URL=https://codeitlab.com/market
# Path the reverse proxy forwards to this process (empty for a dedicated host).
MARKETPLACE_BASE_PATH=/market
# Set to 1 only behind a proxy that overwrites X-Forwarded-For.
MARKETPLACE_TRUST_PROXY=1
# Secure cookies require HTTPS in front of the app.
MARKETPLACE_COOKIE_SECURE=1

# --- login mail -------------------------------------------------------------
# Production must not print codes to stdout.
MARKETPLACE_DEV_EMAIL=0
MARKETPLACE_MAIL_TRANSPORT=webhook
MARKETPLACE_MAIL_WEBHOOK=https://mailer.example.com/codeitlab/login
MARKETPLACE_MAIL_SECRET=replace-with-a-long-random-mail-hmac-key

# --- money ------------------------------------------------------------------
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_CONNECTED_ACCOUNT_ID=acct_replace_me
PAYMENTS_WEBHOOK_SECRET=whsec_replace_me
# 14 days is the documented auto-release window; 0 disables it.
MARKETPLACE_AUTO_RELEASE_DAYS=14
# Run the reminder/alert/release sweep every 15 minutes.
MARKETPLACE_MAINTENANCE_MINUTES=15

# --- operator ---------------------------------------------------------------
# At least 24 random characters. Opening /admin?token=... trades it for a cookie.
MARKETPLACE_ADMIN_TOKEN=replace-with-at-least-24-random-characters
MARKETPLACE_SECURITY_CONTACT=security@codeitlab.com

# --- optional activity outbox (HMAC-signed POSTs) ---------------------------
MARKETPLACE_NOTIFY_WEBHOOK=
MARKETPLACE_NOTIFY_SECRET=

# --- optional Web Push (generate with `pnpm --filter @codeitlab/marketplace push:keys`) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@codeitlab.com

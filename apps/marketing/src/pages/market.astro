---
import Layout from "../layouts/Layout.astro";
import {
  APP_URL,
  MARKETPLACE_JOBS_URL,
  MARKETPLACE_JOIN_URL,
  MARKETPLACE_URL,
} from "../lib/site";

const coderSteps = [
  {
    title: "Declare interest",
    body: "Join with your email, then save a short profile: skills, availability, a rate range, and links to your work.",
  },
  {
    title: "Get matched",
    body: "Businesses post jobs with the skills they need. Each job shows recommended coders, scored on skill overlap, availability, rate fit, and profile completeness.",
  },
  {
    title: "Apply to work",
    body: "Send a short message to an open job. The business sees your application next to its ranked recommendations.",
  },
  {
    title: "Deliver and get paid",
    body: "Accept the engagement, do the work, and mark it delivered. When the business approves it, the platform pays you the engagement amount minus the platform fee: 15% standard, 20% assisted.",
  },
] as const;

const businessSteps = [
  {
    title: "Post the work",
    body: "Describe the job, the skills it needs, the budget, and the timeline. No account fees, no listing fee.",
  },
  {
    title: "See ranked recommendations",
    body: "The marketplace ranks coders for the job and shows the reasons behind each recommendation, so you can disagree with the ranking.",
  },
  {
    title: "Pick a coder",
    body: "Choose a coder and an amount. That charges the business and puts the money in escrow before any work starts.",
  },
  {
    title: "Approve and release",
    body: "Review the delivered work, approve it, and the platform pays the coder minus the platform fee (15% standard, 20% assisted). Cancel and dispute are explicit states, not silent edits.",
  },
] as const;

const faqs = [
  {
    q: "What is a vibe coder?",
    a: "Someone who builds with CodeItLab and coding agents. If you already ship work that way, the marketplace is how you can get paid for it. Joining is opt-in; using the app without the marketplace stays free.",
  },
  {
    q: "Is the app free?",
    a: "Yes. CodeItLab is free to install and use. The marketplace is how the platform makes money: it takes a fee out of paid marketplace work (15% standard, 20% assisted), not a subscription.",
  },
  {
    q: "Who pays the fee?",
    a: "The business is charged the full engagement amount when it picks a coder. When the work is approved, the platform keeps the fee — 15% on a standard job, 20% on an assisted one — and pays the coder the rest. You will see the amount before you commit.",
  },
  {
    q: "When does money change hands?",
    a: "The business is charged when the engagement is created. The platform holds the money while the coder works. It pays the coder after the business approves the delivered work. A cancel before delivery is an explicit state with its own refund path.",
  },
  {
    q: "Can the amount change after I am charged?",
    a: "No. An engagement amount cannot be edited after the charge. Every step is a recorded state transition, so there is no way to skip a step or quietly change the number.",
  },
  {
    q: "Do new coder profiles appear right away?",
    a: "Not necessarily. New profiles start unapproved, and a human reviews them before they appear in public listings and matching. That keeps the recommendations useful for businesses.",
  },
  {
    q: "What does the ranking actually use?",
    a: "Skill overlap with the job's required skills, availability, rate fit against the budget, and profile completeness. The reasons are shown with each recommendation, so a person always makes the final call.",
  },
] as const;
---

<Layout
  title="Marketplace — CodeItLab"
  description="The CodeItLab marketplace: vibe coders declare interest and get matched to paid work by skills. Businesses post jobs, see ranked recommendations, and pay after approval. 15% standard platform fee, 20% assisted. The app is free."
>
  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="market-hero">
    <div class="container market-hero-inner">
      <p class="eyebrow" data-rise>Marketplace</p>
      <h1 class="display market-title">
        <span data-rise>Turn vibe coding</span><br />
        <span data-rise style="--d:90ms">into paid work.</span>
      </h1>
      <p class="market-sub" data-rise style="--d:180ms">
        CodeItLab is free. The marketplace is how the people who build with it
        get paid, and how businesses find them. Coders declare interest and get
        matched to jobs by their skills. Businesses post work and see ranked
        recommendations. The platform holds the money and pays the coder after
        approval.
      </p>
      <div class="market-hero-actions" data-rise style="--d:280ms">
        <a class="btn btn-primary btn-lg" href={APP_URL}>
          Get the free app
        </a>
        <a class="btn btn-ghost btn-lg" href={MARKETPLACE_JOIN_URL}>
          Become a vibe coder
        </a>
      </div>
      <p class="market-hero-note" data-rise style="--d:360ms">
        Free app · 15% standard / 20% assisted fee on paid work · the business pays ·
        <a href={MARKETPLACE_JOBS_URL}>hire a vibe coder</a>
      </p>
    </div>
  </section>

  <!-- ── How it works ──────────────────────────────────────────── -->
  <section id="how-it-works" class="market-section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">How it works</div>
        <h2>Two sides, one recorded handshake.</h2>
        <p>
          Coders and businesses use the same service at
          <a class="inline-link" href={MARKETPLACE_URL}>codeitlab.com/market</a>.
          Every step is a state transition with a ledger entry, so neither side
          has to trust a screenshot.
        </p>
      </div>

      <div class="flow-grid">
        <article class="flow-card tile">
          <header class="flow-head">
            <span class="flow-tag">For coders</span>
            <h3>Declare interest. Get matched. Get paid.</h3>
          </header>
          <ol class="flow-steps">
            {coderSteps.map((step, index) => (
              <li>
                <span class="flow-num">{String(index + 1).padStart(2, "0")}</span>
                <span class="flow-copy">
                  <strong>{step.title}</strong>
                  <span>{step.body}</span>
                </span>
              </li>
            ))}
          </ol>
          <a class="flow-cta btn btn-primary" href={MARKETPLACE_JOIN_URL}>
            Join as a vibe coder
          </a>
        </article>

        <article class="flow-card tile">
          <header class="flow-head">
            <span class="flow-tag">For businesses</span>
            <h3>Post work. See recommendations. Approve.</h3>
          </header>
          <ol class="flow-steps">
            {businessSteps.map((step, index) => (
              <li>
                <span class="flow-num">{String(index + 1).padStart(2, "0")}</span>
                <span class="flow-copy">
                  <strong>{step.title}</strong>
                  <span>{step.body}</span>
                </span>
              </li>
            ))}
          </ol>
          <a class="flow-cta btn btn-primary" href={MARKETPLACE_JOBS_URL}>
            Post a job
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Money ─────────────────────────────────────────────────── -->
  <section id="money" class="market-section market-money">
    <div class="container money-inner">
      <div class="section-head" style="margin-bottom:0">
        <div class="eyebrow">Money</div>
        <h2>Held by the platform. Released on approval.</h2>
        <p>
          The business pays when it picks a coder, not when the work is done.
          CodeItLab holds the money, and the coder is paid after the business
          approves the delivered work. The platform fee is 15% of the engagement
          amount, or 20% when the job is assisted and CodeItLab helps run it. There
          is no subscription for either side.
        </p>
      </div>

      <div class="money-card tile" aria-label="Money flow: business pays the platform, the platform holds the amount in escrow, and the coder is paid the amount minus the platform fee (15% standard, 20% assisted) after approval.">
        <div class="money-card-head">
          <span></span><span></span><span></span>
          <span class="money-card-title">escrow / flow</span>
        </div>
        <div class="money-card-body">
          <div class="money-row">
            <span class="money-label">business</span>
            <span class="money-arrow" aria-hidden="true">→</span>
            <span class="money-label">platform</span>
            <span class="money-amount">full amount</span>
          </div>
          <div class="money-note">charged when the coder is picked</div>
          <div class="money-row">
            <span class="money-label">platform</span>
            <span class="money-arrow" aria-hidden="true">→</span>
            <span class="money-label">coder</span>
            <span class="money-amount money-amount--ok">amount − fee</span>
          </div>
          <div class="money-note">paid after the business approves</div>
          <div class="money-fee">
            <span class="money-fee-value">15% / 20%</span>
            <span>platform fee (standard / assisted), deducted from the engagement amount</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────── -->
  <section id="faq" class="market-section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Questions</div>
        <h2>Plain answers.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Final CTA ─────────────────────────────────────────────── -->
  <section class="market-cta">
    <div class="container market-cta-inner">
      <h2 class="display">The app is free. The work can pay.</h2>
      <p>
        Install CodeItLab, declare you are open to work, and let the matching do
        the searching. Businesses can post a job in the same place.
      </p>
      <div class="market-cta-actions">
        <a class="btn btn-primary btn-lg" href={MARKETPLACE_JOIN_URL}>Become a vibe coder</a>
        <a class="btn btn-ghost btn-lg" href={MARKETPLACE_JOBS_URL}>Hire a vibe coder</a>
        <a class="btn btn-ghost btn-lg" href={APP_URL}>Install the app</a>
      </div>
      <p class="market-cta-note">
        The marketplace service lives at
        <a class="inline-link" href={MARKETPLACE_URL}>codeitlab.com/market</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .inline-link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: rgba(161, 161, 170, 0.5);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.18s ease;
  }

  .inline-link:hover {
    text-decoration-color: var(--fg);
  }

  /* ── Hero ─────────────────────────────────────────────────── */
  .market-hero {
    padding: 96px 0 80px;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .market-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 0%, black 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 0%, black 30%, transparent 100%);
  }

  .market-hero-inner {
    position: relative;
    text-align: center;
  }

  .market-hero .eyebrow {
    margin-bottom: 18px;
  }

  .market-title {
    font-size: clamp(40px, 6.4vw, 84px);
    margin: 0 auto 24px;
    max-width: 18ch;
    text-wrap: balance;
  }

  .market-title span {
    display: inline-block;
  }

  .market-sub {
    color: var(--fg-muted);
    font-size: clamp(16px, 1.4vw, 19px);
    max-width: 680px;
    margin: 0 auto 34px;
    line-height: 1.6;
    letter-spacing: -0.005em;
  }

  .market-hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 18px;
  }

  .market-hero-note {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  /* ── Sections ─────────────────────────────────────────────── */
  .market-section {
    padding: 96px 0;
    border-bottom: 1px solid var(--border);
  }

  .section-head {
    max-width: 720px;
    margin-bottom: 48px;
  }

  .section-head .eyebrow {
    margin-bottom: 14px;
    display: block;
  }

  .section-head h2 {
    font-size: clamp(30px, 3.6vw, 44px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.06;
    margin-bottom: 18px;
  }

  .section-head p {
    color: var(--fg-muted);
    font-size: 17px;
    line-height: 1.6;
    letter-spacing: -0.005em;
  }

  /* ── Flow cards ───────────────────────────────────────────── */
  .flow-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .flow-card {
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 26px;
    background:
      radial-gradient(120% 80% at 100% 0%, var(--accent-dim), transparent 55%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
  }

  .flow-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .flow-head h3 {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .flow-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .flow-steps li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .flow-num {
    flex: none;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-dim);
    padding-top: 3px;
  }

  .flow-copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 14.5px;
    line-height: 1.5;
  }

  .flow-copy strong {
    color: var(--fg);
    font-weight: 600;
  }

  .flow-copy > span {
    color: var(--fg-muted);
  }

  .flow-cta {
    align-self: flex-start;
  }

  /* ── Money ────────────────────────────────────────────────── */
  .money-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .money-card {
    font-family: var(--font-mono);
    font-size: 12px;
    background: #0a0a0c;
  }

  .money-card-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }

  .money-card-head > span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #2a2a30;
  }

  .money-card-title {
    margin-left: 10px;
    color: var(--fg-dim);
    font-size: 11px;
  }

  .money-card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .money-row {
    display: grid;
    grid-template-columns: auto 20px auto 1fr;
    gap: 10px;
    align-items: baseline;
    color: var(--fg);
    padding-top: 10px;
  }

  .money-label {
    color: var(--fg-muted);
  }

  .money-arrow {
    color: var(--accent);
    text-align: center;
  }

  .money-amount {
    justify-self: end;
    font-size: 12px;
    color: var(--fg);
  }

  .money-amount--ok {
    color: var(--ok);
  }

  .money-note {
    color: var(--fg-dim);
    font-size: 10px;
    padding-left: 2px;
  }

  .money-fee {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px dashed var(--border);
    color: var(--fg-dim);
    font-size: 11px;
    line-height: 1.4;
  }

  .money-fee-value {
    flex: none;
    font-size: 24px;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: -0.04em;
  }

  /* ── FAQ ──────────────────────────────────────────────────── */
  .faq-list {
    border-top: 1px solid var(--border);
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
  }

  .faq-item summary {
    cursor: pointer;
    padding: 22px 36px 22px 0;
    position: relative;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.015em;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: "+";
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 18px;
    color: var(--fg-dim);
    transition: transform 0.18s ease, color 0.18s ease;
  }

  .faq-item[open] summary::after {
    content: "−";
    color: var(--fg);
  }

  .faq-item p {
    color: var(--fg-muted);
    font-size: 15px;
    line-height: 1.65;
    max-width: 760px;
    padding: 0 36px 24px 0;
  }

  /* ── Final CTA ────────────────────────────────────────────── */
  .market-cta {
    padding: 110px 0 120px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .market-cta::before {
    content: "";
    position: absolute;
    inset: auto 0 -50% 0;
    height: 60%;
    background: radial-gradient(ellipse at center, var(--accent-dim) 0%, transparent 60%);
    pointer-events: none;
    opacity: 0.6;
  }

  .market-cta-inner {
    position: relative;
  }

  .market-cta h2 {
    font-size: clamp(38px, 5.4vw, 64px);
    margin-bottom: 20px;
  }

  .market-cta p {
    color: var(--fg-muted);
    font-size: 17px;
    line-height: 1.6;
    max-width: 620px;
    margin: 0 auto 32px;
  }

  .market-cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 22px;
  }

  .market-cta-note {
    color: var(--fg-dim);
    font-size: 13px;
  }

  @media (max-width: 960px) {
    .flow-grid {
      grid-template-columns: 1fr;
    }

    .money-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 820px) {
    .market-hero {
      padding: 72px 0 64px;
    }

    .market-section {
      padding: 64px 0;
    }

    .market-cta {
      padding: 84px 0 96px;
    }

    .flow-card {
      padding: 24px;
    }
  }
</style>

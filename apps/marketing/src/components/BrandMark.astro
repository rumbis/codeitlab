---
// The CodeItLab mark, taken from the brand asset codeitlab.com serves as its own
// favicon and touch icon. Inlined rather than linked so it inherits currentColor
// and costs no extra request on a page whose first paint we care about.
interface Props {
  class?: string;
  size?: number;
}
const { class: className, size = 20 } = Astro.props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  role="presentation"
  aria-hidden="true"
>
